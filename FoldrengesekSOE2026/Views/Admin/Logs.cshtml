@model FoldrengesekSOE2026.ViewModels.Admin.LogsIndexViewModel

@{
    ViewData["Title"] = "Logok böngészése";
}

<div class="container mt-4">
    <h1 class="mb-4">Logok böngészése</h1>

    <p>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">
            Vissza az admin kezdőlapra
        </a>
    </p>

    <div class="card mb-4">
        <div class="card-header">
            <strong>Szűrők</strong>
        </div>

        <div class="card-body">
            <form asp-controller="Admin" asp-action="Logs" method="get">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Felhasználó e-mail</label>
                        <input type="text"
                               name="userEmail"
                               value="@Model.UserEmail"
                               class="form-control"
                               placeholder="pl. user@example.com" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Entitás típus</label>
                        <input type="text"
                               name="entityType"
                               value="@Model.EntityType"
                               class="form-control"
                               placeholder="pl. Telepules" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Hitelesítés típusa</label>
                        <select name="isAuthFailure" class="form-select">
                            <option value="">Összes</option>
                            <option value="true" selected="@(Model.IsAuthFailure == true)">
                                Sikertelen auth
                            </option>
                            <option value="false" selected="@(Model.IsAuthFailure == false)">
                                Nem sikertelen auth
                            </option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Oldalméret</label>
                        <select name="pageSize" class="form-select">
                            <option value="25" selected="@(Model.PageSize == 25)">25</option>
                            <option value="50" selected="@(Model.PageSize == 50)">50</option>
                            <option value="100" selected="@(Model.PageSize == 100)">100</option>
                        </select>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">
                        Szűrés
                    </button>

                    <a asp-controller="Admin"
                           asp-action="Logs"
                           class="btn btn-outline-secondary">
                        Szűrők törlése
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Logok</strong>
            <span class="badge bg-secondary">
                Összesen: @Model.TotalCount
            </span>
        </div>

        <div class="card-body">
            @if (!Model.Logs.Any())
            {
                <div class="alert alert-info">
                    Nincs megjeleníthető naplóbejegyzés.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Időpont</th>
                                <th>Felhasználó</th>
                                <th>Metódus</th>
                                <th>Útvonal</th>
                                <th>Státusz</th>
                                <th>Entitás</th>
                                <th>Művelet</th>
                                <th>IP cím</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.Logs)
                            {
                                <tr class="@(log.IsAuthFailure ? "table-danger" : "")">
                                    <td>@log.Id</td>
                                    <td>
                                        <small>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</small>
                                    </td>
                                    <td>
                                        <small>@(log.UserEmail ?? "-")</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@log.HttpMethod</span>
                                    </td>
                                    <td>
                                        <small>@log.Path</small>
                                    </td>
                                    <td>
                                        <span class="badge @(log.StatusCode >= 200 && log.StatusCode < 300 ? "bg-success" : "bg-danger")">
                                            @log.StatusCode
                                        </span>
                                    </td>
                                    <td>
                                        <small>@(log.EntityType ?? "-")</small>
                                    </td>
                                    <td>
                                        <small>@(log.Action ?? "-")</small>
                                    </td>
                                    <td>
                                        <small>@(log.IpAddress ?? "-")</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav>
                        <ul class="pagination justify-content-center">
                            @if (Model.Page > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                           asp-controller="Admin"
                                           asp-action="Logs"
                                           asp-route-userEmail="@Model.UserEmail"
                                           asp-route-entityType="@Model.EntityType"
                                           asp-route-isAuthFailure="@Model.IsAuthFailure"
                                           asp-route-page="@(Model.Page - 1)"
                                           asp-route-pageSize="@Model.PageSize">
                                        Előző
                                    </a>
                                </li>
                            }

                            @for (int i = Math.Max(1, Model.Page - 2);
                                  i <= Math.Min(Model.TotalPages, Model.Page + 2);
                                  i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link"
                                           asp-controller="Admin"
                                           asp-action="Logs"
                                           asp-route-userEmail="@Model.UserEmail"
                                           asp-route-entityType="@Model.EntityType"
                                           asp-route-isAuthFailure="@Model.IsAuthFailure"
                                           asp-route-page="@i"
                                           asp-route-pageSize="@Model.PageSize">
                                        @i
                                    </a>
                                </li>
                            }

                            @if (Model.Page < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                           asp-controller="Admin"
                                           asp-action="Logs"
                                           asp-route-userEmail="@Model.UserEmail"
                                           asp-route-entityType="@Model.EntityType"
                                           asp-route-isAuthFailure="@Model.IsAuthFailure"
                                           asp-route-page="@(Model.Page + 1)"
                                           asp-route-pageSize="@Model.PageSize">
                                        Következő
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>